{
  "manifest_version": 3,
  "name": "PayBon — PAYBACK coupon scout",
  "version": "1.3.1",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "description": "Find PAYBACK coupons for the website you visit. Activate offers and start shopping through PAYBACK.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js"},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "action": {
    "default_popup": "popup.html",
    "default_title": "PayBon — PAYBACK coupons",
    "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "exclude_matches": ["https://payback.de/*", "https://*.payback.de/*"],
      "js": ["core.js", "mascot.js", "amazon.js"],
      "css": ["guard.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.payback.de/coupons*"],
      "js": ["core.js", "payback.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["amazon-payback.png", "roboto.woff2", "payback-light.woff", "fox-sprites.png", "icon-48.png"],
    "matches": ["https://*/*"]
  }],
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}
}
